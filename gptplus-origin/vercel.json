{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/__sb-auth/:path*",
      "destination": "https://cgamktdrqkxnnmnruvvq.supabase.co/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notification-outbox",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/spotify",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/faq",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}

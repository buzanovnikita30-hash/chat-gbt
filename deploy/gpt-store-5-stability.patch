diff --git a/deploy/nginx-gptplus.conf b/deploy/nginx-gptplus.conf
new file mode 100644
index 0000000..f51e604
--- /dev/null
+++ b/deploy/nginx-gptplus.conf
@@ -0,0 +1,57 @@
+# Reverse-proxy for gptplus-store.ru.
+# A dead/slow origin must serve the last cached 200 instead of a white nginx 502.
+#
+# 1. Origin is gpt-store-5.vercel.app (live gptplus-store.ru). Replace if it changes.
+# 2. sudo mkdir -p /var/cache/nginx/gptplus
+# 3. Copy to sites-available, enable, nginx -t && systemctl reload nginx
+
+proxy_cache_path /var/cache/nginx/gptplus levels=1:2 keys_zone=gptplus:20m
+                 max_size=200m inactive=24h use_temp_path=off;
+
+server {
+    listen 443 ssl http2;
+    server_name gptplus-store.ru www.gptplus-store.ru;
+
+    # ssl_certificate     /etc/letsencrypt/live/gptplus-store.ru/fullchain.pem;
+    # ssl_certificate_key /etc/letsencrypt/live/gptplus-store.ru/privkey.pem;
+
+    location /api/health {
+        proxy_pass https://gpt-store-5.vercel.app;
+        proxy_ssl_server_name on;
+        proxy_set_header Host gpt-store-5.vercel.app;
+        proxy_connect_timeout 3s;
+        proxy_read_timeout 5s;
+        add_header Cache-Control "no-store";
+    }
+
+    location / {
+        proxy_pass https://gpt-store-5.vercel.app;
+        proxy_http_version 1.1;
+        proxy_ssl_server_name on;
+        proxy_set_header Host gpt-store-5.vercel.app;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header Connection "";
+
+        proxy_connect_timeout 3s;
+        proxy_send_timeout 8s;
+        proxy_read_timeout 8s;
+
+        proxy_next_upstream error timeout http_502 http_503 http_504;
+        proxy_next_upstream_tries 3;
+
+        proxy_cache gptplus;
+        proxy_cache_methods GET HEAD;
+        proxy_cache_key "$scheme$request_method$host$request_uri";
+        proxy_cache_valid 200 120s;
+        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
+        proxy_cache_lock on;
+        add_header X-Cache-Status $upstream_cache_status always;
+    }
+}
+
+server {
+    listen 80;
+    server_name gptplus-store.ru www.gptplus-store.ru;
+    return 301 https://$host$request_uri;
+}
